APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://finai:finai@db:5432/finai
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads

# --- File storage: "local" (default, fine when backend+worker share a filesystem,
# e.g. Docker Compose) or "r2" (needed when backend and worker run as separate
# hosts/containers with no shared disk) ---
STORAGE_PROVIDER=local
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finance-flag-uploads

VECTOR_STORE=faiss
OCR_PROVIDER=tesseract

# --- LLM provider: "ollama" (free, local, no signup), "groq" (free, hosted,
# fast — used for cloud deploys with no self-hosted model), or "azure" ---
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama. Requires Ollama running on the host with
# `mistral:7b-instruct-q4_0` and `nomic-embed-text` pulled.
# Use http://localhost:11434 outside Docker, http://host.docker.internal:11434 inside it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=mistral:7b-instruct-q4_0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Used when LLM_PROVIDER=groq. Free key from https://console.groq.com/keys — Groq
# has no embeddings endpoint, so embeddings run in-process via a small local ONNX
# model (fastembed, BAAI/bge-small-en-v1.5) instead — no extra signup needed for that part.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Free key from https://www.alphavantage.co/support/#api-key (25 req/day, 5 req/min)
# Powers USD/INR + copper/aluminum data in the market_comparison agent.
ALPHA_VANTAGE_API_KEY=

# --- Market Intelligence: optional free-tier keys ---
# Every provider below works without a key (returns status="not_configured" on its
# cards, same honest treatment as the LME stub) until you paste one in here.

# Free key from https://finnhub.io/register — company news, earnings, analyst sentiment.
FINNHUB_API_KEY=

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html — inflation,
# interest rates, industrial production (St. Louis Fed).
FRED_API_KEY=

# Free key from https://www.eia.gov/opendata/register.php — oil inventory, natural
# gas storage (US Energy Information Administration).
EIA_API_KEY=

# Free key from https://gnews.io/register — manufacturing/infrastructure/power/
# renewable-energy news. Free tier: 100 requests/day, production-use permitted
# (unlike NewsAPI.org's free tier, which is dev-only).
GNEWS_API_KEY=

# Free key from https://newsdata.io/register — used to source real Stardrive-relevant
# signals (metals prices, transmission/refinery/plant projects) for the Market
# Intelligence Executive Brief and Sourced Market Signals section. Free tier caps
# query length at 100 chars, so queries are split into a metals query and a mega-
# projects query rather than one combined query — see newsdata_provider.py.
NEWSDATA_API_KEY=
