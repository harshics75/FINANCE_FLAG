APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://finai:finai@db:5432/finai
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads

VECTOR_STORE=faiss
OCR_PROVIDER=tesseract

# --- LLM provider: "ollama" (free, local, no signup) or "azure" ---
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama. Requires Ollama running on the host with
# `mistral:7b-instruct-q4_0` and `nomic-embed-text` pulled.
# Use http://localhost:11434 outside Docker, http://host.docker.internal:11434 inside it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=mistral:7b-instruct-q4_0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Used when LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Free key from https://www.alphavantage.co/support/#api-key (25 req/day, 5 req/min)
# Powers USD/INR + copper/aluminum data in the market_comparison agent.
ALPHA_VANTAGE_API_KEY=

# --- Market Intelligence: optional free-tier keys ---
# Every provider below works without a key (returns status="not_configured" on its
# cards, same honest treatment as the LME stub) until you paste one in here.

# Free key from https://finnhub.io/register — company news, earnings, analyst sentiment.
FINNHUB_API_KEY=

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html — inflation,
# interest rates, industrial production (St. Louis Fed).
FRED_API_KEY=

# Free key from https://www.eia.gov/opendata/register.php — oil inventory, natural
# gas storage (US Energy Information Administration).
EIA_API_KEY=

# Free key from https://gnews.io/register — manufacturing/infrastructure/power/
# renewable-energy news. Free tier: 100 requests/day, production-use permitted
# (unlike NewsAPI.org's free tier, which is dev-only).
GNEWS_API_KEY=
